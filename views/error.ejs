<% layout("/layouts/boilerplate") %>

<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="text-center" style="max-width: 400px; width: 100%;">
    <div class="alert alert-danger shadow-sm rounded-3 p-3" role="alert">
      <h4 class="fw-bold mb-2">Oops! Something went wrong.</h4>
      <p class="mb-0"> <%= message %></p>
    </div>
    <div class="mt-3">
      <a href="/" class="btn btn-primary btn-sm me-2">Go Home</a>
      <a href="/listings" class="btn btn-outline-primary btn-sm">View Listings</a>
    </div>
  </div>
</div>
