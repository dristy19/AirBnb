<% layout("/layouts/boilerplate") %>

<!-- Main Content -->
<div class="container py-4 d-flex justify-content-center">
  <div class="airbnb-form w-100" style="max-width: 65%;">
    <h5 class="mb-3 fw-semibold">Create a New Listing</h5>
    <form method="POST" action="/listings" class="listing-form needs-validation" novalidate enctype="multipart/form-data">
      
      <!-- Title -->
      <div class="mb-2">
        <label class="form-label small">Title</label>
        <input name="listing[title]" type="text" class="form-control form-control-sm" placeholder="Add a catchy title" required>
        <div class="invalid-feedback">Please provide a title.</div>
      </div>

      <!-- Description -->
      <div class="mb-2">
        <label class="form-label small">Description</label>
        <textarea name="listing[description]" class="form-control form-control-sm" rows="2" placeholder="Description" required></textarea>
        <div class="invalid-feedback">Please provide a description.</div>
      </div>

      <!-- Image Upload -->

      <div class="mb-2">
        <label class="form-label small">Image Upload</label>
        <input name="image" type="file" class="form-control form-control-sm" accept="image/*" required>
        <div class="invalid-feedback">Please provide a valid image file.</div>
      </div>
      

      <!-- Price & Country -->
      <div class="row g-2 mb-2">
        <div class="col-md-6">
          <label class="form-label small">Price</label>
          <input name="listing[price]" type="string" class="form-control form-control-sm" required placeholder="Price">
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>

        <div class="col-md-6">
          <label class="form-label small">Country</label>
          <input name="listing[country]" type="text" class="form-control form-control-sm" required placeholder="Country">
          <div class="invalid-feedback">Please enter the country.</div>
        </div>
      </div>

      <!-- Category -->
<div class="mb-2">
  <label class="form-label small">Category</label>
  <select name="listing[category]" class="form-select form-select-sm" required>
    <option value="" disabled selected>Select a category</option>
    <option value="Rooms">Rooms</option>
    <option value="Iconic Cities">Iconic Cities</option>
    <option value="Mountains">Mountains</option>
    <option value="Castles">Castles</option>
    <option value="Amazing Pools">Amazing Pools</option>
    <option value="Camping">Camping</option>
    <option value="Arctic">Arctic</option>
    <option value="Beach">Beach</option>
    <option value="Surfing">Surfing</option>
    <option value="Farms">Farms</option>
  </select>
  <div class="invalid-feedback">Please select a category.</div>
</div>

      <!-- Location -->
      <div class="mb-2">
        <label class="form-label small">Location</label>
        <input name="listing[location]" type="text" class="form-control form-control-sm" required placeholder="Location">
        <div class="invalid-feedback">Please enter the location.</div>
      </div>

      <!-- Button -->
      <button class="btn btn-danger btn-sm px-3 py-1 rounded-3 mt-2">
        <i class="bi bi-plus-circle me-1"></i> Add
      </button>
    </form>
  </div>
</div>
