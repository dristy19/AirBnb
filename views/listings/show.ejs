<% layout("/layouts/boilerplate") %>

  <div class="show-container d-flex justify-content-center py-4">
    <div class="p-4 shadow-sm bg-white rounded" style="max-width: 600px; font-size: 14px;">

      <h5 class="text-center mb-3 fw-semibold">
        <%= listing.title %>
      </h5>

      <% if (listing.image.url) { %>
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="mb-3 rounded"
          style="object-fit: cover; max-height: 220px; width: 100%;">
        <% } %>

          <p class="listing-owner">
            Owner: <%= listing.owner ? listing.owner.username : "Unknown" %>
          </p>

          <p class="listing-description">
            <%= listing.description %>
          </p>
          <p class="listing-price">₹ <%= listing.price.toLocaleString("en-IN") %>
          </p>
          <p class="listing-location">
            <%= listing.location %>, <%= listing.country %>
          </p>

          <div class="d-flex justify-content-between mt-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-primary px-2 py-1">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
              onsubmit="return confirm('Delete this listing?');">
              <button class="btn btn-sm btn-danger px-2 py-1">Delete</button>
            </form>
          </div>

          <div class="reviews mt-4">
            <h6 class="fw-semibold mb-3">Add a Review</h6>

            <form class="needs-validation airbnb-form" novalidate action="/listings/<%= listing._id %>/reviews"
              method="POST">
              <div class="mb-2">
                <label class="form-label mb-1 d-block">Rating</label>
                <div class="rvw-star-rating">
                  <% for (let i=5; i>= 1; i--) { %>
                    <input type="radio" id="star<%= i %>" name="review[rating]" value="<%= i %>" required />
                    <label for="star<%= i %>" title="<%= i %> stars">★</label>
                    <% } %>
                </div>
                <div class="invalid-feedback">Please select a rating.</div>
              </div>

              <div class="mb-2">
                <label for="reviewComment" class="form-label mb-1">Comment</label>
                <textarea class="form-control form-control-sm" id="reviewComment" name="review[comment]" rows="2"
                  placeholder="Write your review..." required></textarea>
                <div class="invalid-feedback">Please enter a comment.</div>
              </div>

              <div class="text-end">
                <button type="submit" class="btn btn-sm btn-success px-3 py-1">Submit</button>
              </div>
            </form>
          </div>


    </div>
  </div>

  <!-- Reviews Section -->
  <hr class="my-4">
  <% if(listing.reviews.length> 0) { %>
    <h4 class="rvw-title">All Reviews</h4>

    <div class="rvw-list">
      <% if(!listing.reviews || listing.reviews.length===0) { %>
        <p class="text-muted">No reviews yet. Be the first to review!</p>
        <% } else { %>
          <% listing.reviews.forEach(review=> { %>
            <% if(review && review.comment) { %> <!-- Only render if review exists -->
              <div class="rvw-item">
                <div class="rvw-header">
                  <div class="rvw-avatar">
                    <img src="https://i.pravatar.cc/50?u=<%= review._id %>" alt="avatar" class="rounded-circle">
                  </div>
                  <div class="rvw-meta">
                    <div class="rvw-name">
                      <%= review.author ? review.author.username : "Anonymous" %>
                    </div>
                    <div class="rvw-date">
                      <%= review.createdAt ? review.createdAt.toLocaleDateString('en-US', { month: 'short' ,
                        year: 'numeric' }) : "" %>
                    </div>
                  </div>
                </div>

                <div class="rvw-comment">
                  <!-- Star Rating Display -->
                  <div class="rvw-stars mb-1">
                    <% for (let i=1; i <=5; i++) { %>
                      <% if (i <=review.rating) { %>
                        <i class="fa-solid fa-star text-warning"></i>
                        <% } else { %>
                          <i class="fa-regular fa-star text-muted"></i>
                          <% } %>
                            <% } %>
                  </div>

                  <% if (review.comment.length> 200) { %>
                    <span class="rvw-short">
                      <%= review.comment.substring(0, 200) %>...
                    </span>
                    <span class="rvw-full" style="display:none;">
                      <%= review.comment %>
                    </span>
                    <a href="javascript:void(0);" class="rvw-show-more" onclick="toggleFullReview(this)">Show more</a>
                    <% } else { %>
                      <%= review.comment %>
                        <% } %>
                </div>


                <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                  <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    style="display:inline;">
                    <button type="submit" class="btn btn-sm btn-danger px-2 py-0"
                      style="font-size: 10px;">Delete</button>
                  </form>
                  <% } %>
              </div>
              <% } %>
                <% }) %>
                  <% } %>
    </div>
    <% } %>

      <div>
        <h3>Where you'll be </h3>
        <p class="listing-location">
          <%= listing.location %>, <%= listing.country %>
        </p>
        <div id="map" class="my-4"></div>
      </div>

      <script>
        mapboxgl.accessToken = "<%= process.env.MAP_TOKEN %>";
        const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;

        const map = new mapboxgl.Map({
          container: 'map',
          style: 'mapbox://styles/mapbox/streets-v12',
          center: coordinates,
          zoom: 16
        });

        new mapboxgl.Marker({ color: "red" })
          .setLngLat(coordinates)
          .setPopup(
            new mapboxgl.Popup({ offset: 25 })
              .setHTML(`<h6><%= listing.title %></h6><p>Exact location will be provided after booking</p>`)
          )
          .addTo(map);
      </script>