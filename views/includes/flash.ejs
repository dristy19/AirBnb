<% if (success && success.length > 0) { %>
  <div class="position-fixed top-30 start-50 translate-middle-x mt-3" style="z-index: 1055; width: auto;">
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 px-4 py-2 d-flex align-items-center" role="alert" style="min-width: 300px;">
      <i class="bi bi-check-circle-fill me-2 fs-5"></i>
      <div class="mx-4"><%= success %></div>
      <button type="button" class="btn-close ms-5" data-bs-dismiss="alert" aria-label="Close" style="font-size: 12px;"></button>
    </div>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="position-fixed top-30 start-50 translate-middle-x mt-3" style="z-index: 1055; width: auto;">
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 px-4 py-2 d-flex align-items-center" role="alert" style="min-width: 300px;">
      <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
      <div class="mx-4"><%= error %></div>
      <button type="button" class="btn-close ms-5" data-bs-dismiss="alert" aria-label="Close" style="font-size: 12px;"></button>
    </div>
  </div>
<% } %>

